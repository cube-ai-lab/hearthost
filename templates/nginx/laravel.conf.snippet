# Laravel docroot is /home/{user}/{domain}/public (or public_html/public).
index index.php;

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

location ~ /\.(?!well-known).* {
    deny all;
}

location ~ \.php$ {
    include snippets/fastcgi-php.conf;
    fastcgi_pass unix:{{FPM_SOCKET}};
}
