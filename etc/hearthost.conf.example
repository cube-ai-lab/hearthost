# Hearthost runtime configuration
# Copy to /etc/hearthost/hearthost.conf (or keep a local copy for tests).
# KEY=value. Quotes optional. Lines starting with # are ignored.

# lve  = dedicated PHP-FPM per user inside a systemd slice (default, 1G/1CPU)
# lite = shared PHP-FPM per PHP version (escape hatch for tiny VPS)
profile=lve

# Per-user defaults (CloudLinux-style). Root can override per user.
default_memory=1G
default_cpu=100%
default_tasks=120
default_swap=256M
default_php=8.3
php_versions=8.2,8.3,8.4,8.5

# PHP process memory used to derive pm.max_children from the user RAM cap.
php_memory_limit=256M

# OPcache per tenant. memory is MB, files is max cached scripts. validate=1
# checks mtime every revalidate_freq s (safe default); set 0 for max speed
# (then `hearthost wp` / deploys must flush opcache).
opcache_memory=128
opcache_files=10000
opcache_validate=1

# FastCGI microcache: default TTL (seconds) for anonymous GET when a site
# opts in with `site add --microcache N`. Zone size is in MB.
microcache_seconds=0
microcache_zone_mb=64

# Filesystem layout
home_root=/home
primary_docroot=public_html

# Network
listen_http=80
listen_https=443
ftp_enable=yes
ftp_port=21
ftp_pasv_min=40000
ftp_pasv_max=40099
sftp_enable=yes
sftp_group=hearthost-sftp
ssh_group=hearthost-ssh

# phpMyAdmin is never mounted on customer sites.
# Leave blank here. The server admin supplies a dedicated FQDN at install:
#   hearthost init mariadb --phpmyadmin-host pma.example.com
# Do not commit a live hostname.
phpmyadmin_enable=yes
phpmyadmin_host=

# MariaDB stays on loopback. Database names for user "alice" are alice_*.
mysql_bind=127.0.0.1
mysql_prefix_separator=_

# Default WordPress database suffix: alice_wp.
wp_db_name=wp

# TLS / Let's Encrypt
# Account email is supplied by the server admin at install, never shipped
# in this repo: --letsencrypt-email ops@example.com
# Lineage: /etc/letsencrypt/live/{domain}/
# Published: /home/{user}/ssl/{domain}/ or /etc/hearthost/ssl/{domain}/
letsencrypt_email=
tls_min=TLSv1.2

# Backups and health (Phase 8)
backup_dir=/var/backups/hearthost
backup_keep=7
# health thresholds
cert_warn_days=14
disk_warn_pct=85

# Admin
log_level=info
