listen=YES
listen_ipv6=NO
anonymous_enable=NO
local_enable=YES
write_enable=YES
local_umask=022
chroot_local_user=YES
allow_writeable_chroot=YES
user_sub_token=$USER
local_root=/home/$USER
userlist_enable=YES
userlist_file=/etc/hearthost/ftp.users
userlist_deny=NO
xferlog_enable=YES
dual_log_enable=YES
pasv_min_port=40000
pasv_max_port=40099
ssl_enable=YES
rsa_cert_file=/etc/ssl/certs/hearthost-ftp.pem
rsa_private_key_file=/etc/ssl/private/hearthost-ftp.key
force_local_logins_ssl=NO
force_local_data_ssl=NO
ssl_tlsv1_2=YES
ssl_sslv2=NO
ssl_sslv3=NO
require_ssl_reuse=NO
seccomp_sandbox=YES
hide_file=^\..*
dirlist_enable=YES
download_enable=YES
connect_from_port_20=YES
