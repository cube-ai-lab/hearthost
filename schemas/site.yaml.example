# /etc/hearthost/sites.d/{domain}.yaml
domain: example.com
user: alice
# primary sites use /home/{user}/public_html
# addon domains and subdomains use /home/{user}/{domain}
primary: true
php: "8.3"
app: wordpress   # wordpress | laravel | php
ssl: true
# Optional FastCGI microcache for anonymous GET (seconds). 0 = off.
# Set with: hearthost site add ... --microcache 10
microcache: 0
aliases: []
created: ""
