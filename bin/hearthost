#!/usr/bin/env bash
# Hearthost CLI — multi-tenant WordPress/Laravel hosting without a panel.
set -euo pipefail

HEARTHOST_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HEARTHOST_ROOT="$(cd "$HEARTHOST_BIN/.." && pwd)"
export HEARTHOST_ROOT

# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/common.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/config.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/validate.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/paths.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/quota.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/os.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/perms.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/doctor.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/hardening.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/nginx.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/ssl.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/mariadb.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/php.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/phpmyadmin.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/slice.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/ftp.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/user.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/site.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/wp.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/backup.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/health.sh"
# shellcheck source=/dev/null
. "$HEARTHOST_ROOT/lib/audit.sh"

hh_usage() {
  cat <<EOF
hearthost $(hh_version) — CLI-first multi-tenant hosting

Usage:
  hearthost <command> [arguments]

Commands:
  doctor [--stack]          Preflight (default) or post-install stack check
  os                        Print detected OS family and support
  init hardening [--phpmyadmin-host FQDN]
                            Phase 1: firewall, SSH groups, sysctl, fail2ban
                            Prompts for phpMyAdmin hostname if unset
  init nginx                Phase 2: Nginx, TLS snippets, WP/Laravel vhosts
  init mariadb [--phpmyadmin-host FQDN] [--letsencrypt-email EMAIL]
                            Phase 3: MariaDB, phpMyAdmin, certbot
  init ssl                  Install certbot, HTTP-01 webroot, renew hook
  init php                  Phase 4: PHP-FPM 8.2–8.5 (ondrej/php or Remi)
  init sftp                 Phase 5: SFTP chroot policy (reload sshd)
  init ftp                  Phase 5: vsftpd (FTPS), opt-in via ftp_enable
  init slices               Phase 6: (re)apply per-tenant RAM/CPU caps
  init wp                   Phase 7: install wp-cli
  init logrotate            Phase 8: per-tenant log rotation
  init backups              Phase 8: nightly backup timer
  slice apply USER [--memory M] [--cpu C] [--tasks N]
                            Cap a tenant's slice (RAM/CPU/tasks)
  backup run [USER]         Back up tenant files + databases (all if no USER)
  backup list [USER]        List backup snapshots
  health                    Service / FPM / cert / disk health (exit 1 on fail)
  audit                     Defensive isolation scan (exit 1 on any risk)
  php versions              Print configured PHP versions
  php pool USER VERSION     Render a per-user FPM pool (USER:USER)
  user add USER [--sftp-only] [--password PW] [--no-db] [--memory M] [--cpu C]
                            Create a tenant: account, home, group, DB grant
  user del USER [--purge]   Remove a tenant (keeps data unless --purge)
  site add USER DOMAIN [--php V] [--app wordpress|laravel|php]
           [--primary] [--alias NAME]... [--no-ssl] [--microcache SECONDS]
                            Provision a vhost + PHP pool + TLS for a domain
  site del DOMAIN [--purge] Remove a site (keeps docroot unless --purge)
  db create USER NAME       Create database {user}_{name} + tenant grant
  wp install USER DOMAIN [--title T] [--admin-user U] [--admin-email E] [--admin-password PW]
                            Install WordPress into the site docroot
  ftp allow|deny USER       Add/remove a tenant from the FTP allow-list
  ssl issue --user USER DOMAIN
                            Issue Let's Encrypt cert into /home/{user}/ssl/{domain}/
  ssl issue --system DOMAIN Issue cert into /etc/hearthost/ssl/{domain}/
  path user HOME            Print /home/{user}
  path docroot USER DOMAIN [--primary]
  path owner USER           Print user:user ownership
  path perms home|webroot|file|secret|logs|tmp|ssl
  path ssl USER [DOMAIN]    Print /home/{user}/ssl[/{domain}]
  path ssl-system [DOMAIN]  Print /etc/hearthost/ssl[/{domain}]
  path db USER NAME         Print prefixed database name
  quota children MEMORY     PHP-FPM pm.max_children for a RAM cap
  quota bytes SIZE          Parse 256M / 1G to bytes
  validate user|domain|php  Exit 0 if the value is allowed
  version                   Print version
  help                      This message

EOF
}

hh_cmd_db() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    create) hh_db_create "$@" ;;
    *) hh_die "usage: hearthost db create USER NAME" ;;
  esac
}

hh_cmd_site() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add) hh_site_add "$@" ;;
    del|rm|remove) hh_site_del "$@" ;;
    *) hh_die "usage: hearthost site add USER DOMAIN [...] | site del DOMAIN [--purge]" ;;
  esac
}

hh_cmd_user() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add|create) hh_user_add "$@" ;;
    del|rm|remove) hh_user_del "$@" ;;
    *) hh_die "usage: hearthost user add USER [...] | user del USER [--purge]" ;;
  esac
}

hh_cmd_slice() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    apply) hh_slice_apply "$@" ;;
    *) hh_die "usage: hearthost slice apply USER [--memory M] [--cpu C] [--tasks N]" ;;
  esac
}

# init slices: (re)apply the cap to every tenant that has a state record.
hh_slices_apply_all() {
  hh_require_root
  hh_config_load
  local dir f user applied=0
  dir="$(dirname "$(hh_user_state x)")"
  [[ -d "$dir" ]] || { hh_info "no tenants yet ($dir empty)"; return 0; }
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    user="$(sed -n 's/^username:[[:space:]]*//p' "$f" | head -1)"
    [[ -n "$user" ]] && getent passwd "$user" >/dev/null || continue
    hh_slice_apply "$user" >/dev/null && applied=$((applied + 1))
  done < <(find "$dir" -maxdepth 1 -type f -name '*.yaml')
  hh_info "applied slice caps to $applied tenant(s)"
}

hh_cmd_path() {
  hh_config_load
  local kind="${1:-}"
  shift || true
  case "$kind" in
    user|home)
      [[ -n "${1:-}" ]] || hh_die "usage: hearthost path user USER"
      hh_valid_username "$1" || hh_die "invalid username: $1"
      hh_user_home "$1"
      ;;
    docroot)
      local user="${1:-}" domain="${2:-}" primary=no
      shift 2 2>/dev/null || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --primary) primary=yes ;;
          *) hh_die "unknown flag $1" ;;
        esac
        shift
      done
      [[ -n "$user" && -n "$domain" ]] || hh_die "usage: hearthost path docroot USER DOMAIN [--primary]"
      hh_valid_username "$user" || hh_die "invalid username: $user"
      hh_valid_domain "$domain" || hh_die "invalid domain: $domain"
      hh_site_docroot "$user" "$domain" "$primary"
      ;;
    db)
      [[ -n "${1:-}" && -n "${2:-}" ]] || hh_die "usage: hearthost path db USER NAME"
      hh_valid_username "$1" || hh_die "invalid username: $1"
      hh_db_name "$1" "$2"
      ;;
    socket)
      [[ -n "${1:-}" && -n "${2:-}" ]] || hh_die "usage: hearthost path socket PHP USER"
      hh_valid_php "$1" || hh_die "invalid PHP version: $1"
      hh_valid_username "$2" || hh_die "invalid username: $2"
      hh_fpm_socket "$1" "$2"
      ;;
    owner)
      [[ -n "${1:-}" ]] || hh_die "usage: hearthost path owner USER"
      hh_valid_username "$1" || hh_die "invalid username: $1"
      hh_perm_owner "$1"
      ;;
    ssl)
      [[ -n "${1:-}" ]] || hh_die "usage: hearthost path ssl USER [DOMAIN]"
      hh_valid_username "$1" || hh_die "invalid username: $1"
      if [[ -n "${2:-}" ]]; then
        hh_valid_domain "$2" || hh_die "invalid domain: $2"
        hh_site_ssl_dir "$1" "$2"
      else
        hh_user_ssl_dir "$1"
      fi
      ;;
    ssl-system)
      if [[ -n "${1:-}" ]]; then
        hh_valid_domain "$1" || hh_die "invalid domain: $1"
        hh_system_ssl_site_dir "$1"
      else
        hh_system_ssl_dir
      fi
      ;;
    perms)
      case "${1:-}" in
        home) hh_perm_home ;;
        webroot|docroot) hh_perm_webroot ;;
        dir) hh_perm_dir ;;
        file) hh_perm_file ;;
        secret) hh_perm_secret ;;
        logs) hh_perm_logs ;;
        tmp) hh_perm_tmp ;;
        ssl) hh_perm_ssl ;;
        ssl-key|key) hh_perm_ssl_key ;;
        *) hh_die "usage: hearthost path perms home|webroot|file|secret|logs|tmp|ssl" ;;
      esac
      ;;
    *)
      hh_die "usage: hearthost path user|docroot|owner|ssl|perms|db|socket ..."
      ;;
  esac
}

hh_cmd_quota() {
  hh_config_load
  local kind="${1:-}"
  shift || true
  case "$kind" in
    children)
      [[ -n "${1:-}" ]] || hh_die "usage: hearthost quota children MEMORY"
      hh_php_max_children "$1" "${2:-}"
      ;;
    bytes)
      [[ -n "${1:-}" ]] || hh_die "usage: hearthost quota bytes SIZE"
      hh_parse_bytes "$1"
      ;;
    cpu)
      [[ -n "${1:-}" ]] || hh_die "usage: hearthost quota cpu 100%|1"
      hh_parse_cpu_quota "$1"
      ;;
    *)
      hh_die "usage: hearthost quota children|bytes|cpu ..."
      ;;
  esac
}

hh_cmd_validate() {
  hh_config_load
  local kind="${1:-}" value="${2:-}"
  [[ -n "$kind" && -n "$value" ]] || hh_die "usage: hearthost validate user|domain|php VALUE"
  case "$kind" in
    user) hh_valid_username "$value" ;;
    domain) hh_valid_domain "$value" ;;
    php) hh_php_allowed "$value" ;;
    app) hh_valid_app "$value" ;;
    *) hh_die "unknown validate kind: $kind" ;;
  esac
}

hh_cmd_doctor() {
  local mode=preflight
  if [[ "${1:-}" == "--stack" ]]; then
    mode=stack
  elif [[ -n "${1:-}" ]]; then
    hh_die "usage: hearthost doctor [--stack]"
  fi
  hh_doctor_run "$mode"
}

hh_cmd_ssl() {
  hh_config_load
  hh_os_load
  local kind="${1:-}"
  shift || true
  case "$kind" in
    install|apply)
      hh_ssl_apply
      ;;
    issue)
      local user="" domain="" system=no
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --user)
            user="${2:-}"
            shift
            ;;
          --user=*) user="${1#*=}" ;;
          --system)
            system=yes
            if [[ -n "${2:-}" && "${2:-}" != --* ]]; then
              domain="$2"
              shift
            fi
            ;;
          --system=*)
            system=yes
            domain="${1#*=}"
            ;;
          --staging) export HEARTHOST_SSL_STAGING=1 ;;
          *)
            if [[ -z "$domain" ]]; then
              domain="$1"
            else
              hh_die "usage: hearthost ssl issue --user USER DOMAIN | --system DOMAIN"
            fi
            ;;
        esac
        shift
      done
      if [[ "$system" == yes ]]; then
        [[ -n "$domain" ]] || hh_die "usage: hearthost ssl issue --system DOMAIN"
        hh_ssl_issue_system "$domain"
      else
        [[ -n "$user" && -n "$domain" ]] || hh_die "usage: hearthost ssl issue --user USER DOMAIN"
        hh_ssl_issue_user "$user" "$domain"
      fi
      ;;
    *)
      hh_die "usage: hearthost ssl install | issue --user USER DOMAIN | issue --system DOMAIN"
      ;;
  esac
}

hh_cmd_init() {
  local target="" pma="" email=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --phpmyadmin-host)
        [[ -n "${2:-}" ]] || hh_die "missing --phpmyadmin-host value"
        pma="$2"
        shift
        ;;
      --phpmyadmin-host=*)
        pma="${1#*=}"
        ;;
      --letsencrypt-email)
        [[ -n "${2:-}" ]] || hh_die "missing --letsencrypt-email value"
        email="$2"
        shift
        ;;
      --letsencrypt-email=*)
        email="${1#*=}"
        ;;
      hardening|phase1)
        target=hardening
        ;;
      nginx|phase2)
        target=nginx
        ;;
      mariadb|db|phase3)
        target=mariadb
        ;;
      ssl|certbot)
        target=ssl
        ;;
      php|php-fpm|phase4)
        target=php
        ;;
      sftp)
        target=sftp
        ;;
      ftp|vsftpd)
        target=ftp
        ;;
      slices|slice|phase6)
        target=slices
        ;;
      wp|wp-cli|wpcli)
        target=wp
        ;;
      logrotate|logs)
        target=logrotate
        ;;
      backups|backup)
        target=backups
        ;;
      *)
        hh_die "usage: hearthost init hardening|nginx|mariadb|ssl|php|sftp|ftp [--phpmyadmin-host FQDN] [--letsencrypt-email EMAIL]"
        ;;
    esac
    shift
  done
  if [[ -n "$email" ]]; then
    hh_config_load
    hh_valid_email "$email" || hh_die "invalid letsencrypt_email: $email"
    hh_conf_set letsencrypt_email "$email"
  fi
  case "$target" in
    hardening)
      HEARTHOST_PHPMYADMIN_HOST_FLAG="$pma"
      export HEARTHOST_PHPMYADMIN_HOST_FLAG
      hh_harden_apply
      ;;
    nginx)
      hh_nginx_apply
      ;;
    ssl)
      hh_ssl_apply
      ;;
    php)
      hh_php_apply
      ;;
    sftp)
      hh_sftp_apply
      ;;
    ftp)
      hh_ftp_apply
      ;;
    slices)
      hh_slices_apply_all
      ;;
    wp)
      hh_wpcli_install
      ;;
    logrotate)
      hh_logrotate_apply
      ;;
    backups)
      hh_backup_timer_apply
      ;;
    mariadb)
      HEARTHOST_PHPMYADMIN_HOST_FLAG="$pma"
      export HEARTHOST_PHPMYADMIN_HOST_FLAG
      hh_db_stack_apply
      ;;
    *)
      hh_die "usage: hearthost init hardening|nginx|mariadb|ssl|php|sftp|ftp [--phpmyadmin-host FQDN] [--letsencrypt-email EMAIL]"
      ;;
  esac
}

hh_cmd_php() {
  hh_config_load
  hh_os_load
  local kind="${1:-}"
  shift || true
  case "$kind" in
    versions|"")
      hh_php_versions
      ;;
    pool)
      local user="${1:-}" ver="${2:-}" dest="${3:-}"
      [[ -n "$user" && -n "$ver" ]] || hh_die "usage: hearthost php pool USER VERSION"
      hh_valid_username "$user" || hh_die "invalid username: $user"
      hh_php_allowed "$ver" || hh_die "PHP $ver is not in php_versions"
      if [[ -z "$dest" ]]; then
        dest="$(mktemp)"
        hh_php_render_pool "$user" "$ver" "$dest"
        cat "$dest"
        rm -f "$dest"
      else
        hh_php_render_pool "$user" "$ver" "$dest"
      fi
      ;;
    *)
      hh_die "usage: hearthost php versions | pool USER VERSION"
      ;;
  esac
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    doctor) hh_cmd_doctor "$@" ;;
    os)
      hh_os_load
      printf 'pretty=%s\nid=%s\nversion=%s\nfamily=%s\nweb_user=%s\nsupported=%s\n' \
        "$(hh_os_pretty)" "$(hh_os_id)" "$(hh_os_version)" "$(hh_os_family)" \
        "$(hh_os_web_user)" "$(hh_os_supported && echo yes || echo no)"
      ;;
    path) hh_cmd_path "$@" ;;
    quota) hh_cmd_quota "$@" ;;
    validate) hh_cmd_validate "$@" ;;
    version|--version) hh_version ;;
    help|-h|--help) hh_usage ;;
    init) hh_cmd_init "$@" ;;
    ssl) hh_cmd_ssl "$@" ;;
    php) hh_cmd_php "$@" ;;
    site) hh_cmd_site "$@" ;;
    user) hh_cmd_user "$@" ;;
    slice) hh_cmd_slice "$@" ;;
    ftp) hh_ftp_cmd "$@" ;;
    db) hh_cmd_db "$@" ;;
    wp) hh_wp_cmd "$@" ;;
    backup) hh_backup_cmd "$@" ;;
    health) hh_health_run ;;
    audit|scan) hh_audit_run ;;
    *)
      hh_usage >&2
      hh_die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
