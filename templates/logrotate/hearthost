# Hearthost per-tenant logs: /home/{user}/logs/{domain}.{access,error}.log
# and php{ver}-fpm.log. copytruncate keeps the original file (and its
# user:user ownership) so Nginx/PHP-FPM need no reopen signal.
/home/*/logs/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    nodateext
    su root root
}
