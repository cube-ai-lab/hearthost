[{{USER}}]
; PHP runs as the site Unix user. Website files stay USER:USER.
user = {{USER}}
group = {{USER}}
listen = {{FPM_SOCKET}}
listen.owner = {{USER}}
; WEB_USER is the Nginx daemon (www-data or nginx), not the file owner.
listen.group = {{WEB_USER}}
listen.mode = 0660

pm = ondemand
pm.max_children = {{MAX_CHILDREN}}
pm.process_idle_timeout = 10s
pm.max_requests = 500

chdir = {{HOME}}
catch_workers_output = yes
security.limit_extensions = .php

php_admin_value[open_basedir] = {{HOME}}:/usr/share/php
php_admin_value[upload_tmp_dir] = {{HOME}}/tmp
php_admin_value[session.save_path] = {{HOME}}/tmp/sessions
php_admin_value[memory_limit] = {{PHP_MEMORY_LIMIT}}
php_admin_flag[allow_url_include] = off
php_admin_flag[expose_php] = off
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,popen,show_source,pcntl_exec,pcntl_fork

; OPcache: compiled bytecode cache, per tenant (counts toward the slice RAM).
php_admin_flag[opcache.enable] = On
php_admin_flag[opcache.enable_cli] = Off
php_admin_value[opcache.memory_consumption] = {{OPCACHE_MEMORY}}
php_admin_value[opcache.interned_strings_buffer] = 16
php_admin_value[opcache.max_accelerated_files] = {{OPCACHE_FILES}}
php_admin_value[opcache.validate_timestamps] = {{OPCACHE_VALIDATE}}
php_admin_value[opcache.revalidate_freq] = 2
