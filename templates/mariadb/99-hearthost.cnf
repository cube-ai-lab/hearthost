[mysqld]
# ── Network & Security ──────────────────────────────────────────
bind-address            = {{BIND}}
skip-name-resolve       = 1
local_infile            = 0
max_allowed_packet      = 64M

# ── Connections ─────────────────────────────────────────────────
# ~20 per tenant (PHP-FPM pm.max_children=5 + overhead); cap at 200
max_connections         = 200
max_user_connections    = 25
wait_timeout            = 300
interactive_timeout     = 600
thread_cache_size       = 50
back_log                = 128

# ── Character Set ───────────────────────────────────────────────
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# ── InnoDB (WordPress is 100% InnoDB) ───────────────────────────
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 1
innodb_log_file_size    = 256M
innodb_log_buffer_size  = 32M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method     = O_DIRECT
innodb_file_per_table   = 1
innodb_io_capacity      = 400
innodb_io_capacity_max  = 800
innodb_read_io_threads  = 4
innodb_write_io_threads = 4
innodb_change_buffering = all
innodb_open_files       = 4000
innodb_doublewrite      = 1

# ── Temp Tables & Joins ────────────────────────────────────────
tmp_table_size          = 64M
max_heap_table_size     = 64M
join_buffer_size        = 1M
sort_buffer_size        = 2M
read_buffer_size        = 256K
read_rnd_buffer_size    = 512K

# ── Table & Open File Cache ─────────────────────────────────────
table_open_cache        = 4000
table_definition_cache  = 2000
open_files_limit        = 65535

# ── MyISAM (minimal — kept for system tables only) ──────────────
key_buffer_size         = 32M
myisam_sort_buffer_size = 64M

# ── Query Cache (disabled — WordPress uses object cache) ────────
query_cache_type        = 0
query_cache_size        = 0

# ── Logging ─────────────────────────────────────────────────────
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/mariadb-slow.log
long_query_time         = 2
log_slow_verbosity      = query_plan,explain
log_warnings            = 2
log_error               = /var/log/mysql/error.log

# ── Binary Log (point-in-time recovery) ─────────────────────────
log_bin                 = /var/log/mysql/mariadb-bin
binlog_format           = ROW
expire_logs_days        = 7
max_binlog_size         = 256M
sync_binlog             = 0

# ── Performance Schema (low overhead monitoring) ────────────────
performance_schema      = ON
